{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Khataboss",
  "version": "0.1.0",
  "identifier": "com.khataboss.app",
  "build": {
    "beforeDevCommand": "npm run start",
    "beforeBuildCommand": "npm run react-build",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Khataboss – Loan & Finance",
        "label": "main",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "decorations": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}